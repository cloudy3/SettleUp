<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive-icon foreground: a coin split down the middle ("settle up").
     108x108 viewport; artwork is kept inside the centre 66dp safe zone so no
     launcher mask can clip it. -->
<vector xmlns:android="http://schemas.android.com/apk/res/android"
    android:width="108dp"
    android:height="108dp"
    android:viewportWidth="108"
    android:viewportHeight="108">
    <!-- Coin rim -->
    <path
        android:pathData="M54,25 A29,29 0 0 1 54,83 A29,29 0 0 1 54,25 Z"
        android:strokeColor="#FFFFFF"
        android:strokeWidth="7" />
    <!-- Filled left half: the split -->
    <path
        android:pathData="M54,30 A24,24 0 0 0 54,78 Z"
        android:fillColor="#FFFFFF" />
</vector>
